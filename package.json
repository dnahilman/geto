{
  "name": "geto",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/desktop",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run dev:desktop",
    "dev:desktop": "bun run --filter @geto/desktop dev",
    "dev:web": "bun run --filter @geto/web dev & cargo run -p geto-server",
    "build:desktop": "bun run --filter @geto/desktop build",
    "build": "bun run --filter @geto/web build && cargo build --release -p geto-server",
    "start": "./target/release/geto-server",
    "docker:build": "podman build -t geto:latest .",
    "codegen": "cargo run -p geto-server -- export-openapi > openapi.json && bunx openapi-typescript openapi.json -o apps/web/src/lib/types/api.d.ts",
    "format": "prettier --write \"{apps,packages}/**/*.{ts,svelte,js,json,css}\"",
    "lint": "eslint .",
    "bump": "bumpp",
    "bump:patch": "bumpp patch",
    "bump:minor": "bumpp minor",
    "bump:major": "bumpp major",
    "copy:key": "clip.exe < ~/.tauri/geto.key && echo 'Private key copied to clipboard!'",
    "generate:icons": "bun .temp/generate-icons.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.1",
    "bumpp": "^12.3.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.11.0",
    "playwright-core": "^1.60.0",
    "prettier": "^3.4.2",
    "prettier-plugin-svelte": "^3.3.3",
    "svelte-eslint-parser": "^1.8.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.68.0"
  }
}
