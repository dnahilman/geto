{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Geto",
  "version": "0.4.0",
  "identifier": "com.geto.app",
  "build": {
    "beforeDevCommand": "bun run --filter @geto/web dev",
    "devUrl": "http://localhost:5174",
    "beforeBuildCommand": "bun run --filter @geto/web build",
    "frontendDist": "../../../apps/web/build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Geto",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "decorations": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
